  <Comment>
    <CommentTable schema="THIPPERS" name="YPSN_DATI_ECOMMERCE" text="Pers connettore e-commerce">
      <CommentColumn name="ORIZZONTE_DATA_CONSEGNA" text="Giorni da sommare a oggi per la data richiesta"/>
      <CommentColumn name="GIORNI_VALIDITA_OFFERTA" text="Giorni da sommare a oggi per la validita offerta"/>
