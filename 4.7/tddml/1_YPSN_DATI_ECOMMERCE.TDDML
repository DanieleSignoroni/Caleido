<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE TDDML SYSTEM "../../../TDDML.dtd">
<TDDML>
  <!-- YPSN_DATI_ECOMMERCE (YPSN_D0): Pers connettore e-commerce; -->
  <CreateTable schema="THIPPERS" name="YPSN_DATI_ECOMMERCE" shortname="YPSN_D0">
    <Column name="ID_AZIENDA" shortname="ID_AZIENDA" type="char" length="3" nullable="no"/>
    <Column name="STATO" shortname="STATO" type="char" length="1" nullable="no"/>
    <Column name="R_UTENTE_CRZ" shortname="R_UTENTE_C" type="char" length="20" nullable="yes"/>
    <Column name="TIMESTAMP_CRZ" shortname="TIMESTAMP_" type="timestamp" nullable="no" default="CURRENT TIMESTAMP"/>
    <Column name="R_UTENTE_AGG" shortname="R_UTENTE_A" type="char" length="20" nullable="yes"/>
    <Column name="TIMESTAMP_AGG" shortname="TIMESTAMP0" type="timestamp" nullable="no" default="CURRENT TIMESTAMP"/>
    <Column name="R_NUMERATORE_OFF_VEN" shortname="R_NUMERATO" type="char" length="15" nullable="no"/>
    <Column name="R_SERIE_OFF_VEN" shortname="R_SERIE_OF" type="char" length="2" nullable="no"/>
    <Column name="R_VALUTA" shortname="R_VALUTA" type="char" length="4" nullable="no"/>
    <Column name="R_ASSOG_IVA" shortname="R_ASSOG_IV" type="char" length="3" nullable="no"/>
    <Column name="R_CAU_OFF_TES" shortname="R_CAU_OFF_" type="char" length="3" nullable="no"/>
    <Column name="R_CAU_OFF_RIG" shortname="R_CAU_OFF0" type="char" length="3" nullable="no"/>
    <Column name="R_CAU_RIG_OFF_SC_MERCE" shortname="R_CAU_RIG_" type="char" length="3" nullable="no"/>
  </CreateTable>
  <CreateIndex schema="THIPPERS" name="YPSN_DATI_ECOM_I01" tabschema="THIPPERS" tabname="YPSN_DATI_ECOMMERCE" shortname="YPSN_D_I02" unique="yes">
    <IndexCol name="ID_AZIENDA" order="Asc"/>
  </CreateIndex>
  <AlterTable schema="THIPPERS" name="YPSN_DATI_ECOMMERCE">
    <AddPrimaryKey>
      <PrimaryKey>
        <ColumnRef name="ID_AZIENDA"/>
      </PrimaryKey>
    </AddPrimaryKey>
  </AlterTable>
  <Comment>
    <CommentTable schema="THIPPERS" name="YPSN_DATI_ECOMMERCE" text="Pers connettore e-commerce">
      <CommentColumn name="ID_AZIENDA" text="Azienda"/>
      <CommentColumn name="STATO" text="Stato"/>
      <CommentColumn name="R_UTENTE_CRZ" text="Utente creazione"/>
      <CommentColumn name="TIMESTAMP_CRZ" text="Timestamp creazione"/>
      <CommentColumn name="R_UTENTE_AGG" text="Utente ultima modifica"/>
      <CommentColumn name="TIMESTAMP_AGG" text="Timestamp ultima modifica"/>
      <CommentColumn name="R_NUMERATORE_OFF_VEN" text="Serie"/>
      <CommentColumn name="R_SERIE_OFF_VEN" text="Serie"/>
      <CommentColumn name="R_VALUTA" text="Valuta"/>
      <CommentColumn name="R_ASSOG_IVA" text="Assog. IVA"/>
      <CommentColumn name="R_CAU_OFF_TES" text="Cau. testata offerta"/>
      <CommentColumn name="R_CAU_OFF_RIG" text="Cau. riga offerta"/>
      <CommentColumn name="R_CAU_RIG_OFF_SC_MERCE" text="Cau. riga offerta sc. merce"/>
    </CommentTable>
    <CommentIndex schema="THIPPERS" name="YPSN_DATI_ECOM_I01" text="Primary Key"/>
  </Comment>
  <Grant schema="THIPPERS" name="YPSN_DATI_ECOMMERCE"/>
</TDDML>
