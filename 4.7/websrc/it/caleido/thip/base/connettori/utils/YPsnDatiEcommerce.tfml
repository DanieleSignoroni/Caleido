<tfml>
  <generator type="form"/>
  <form classHdr="YPsnDatiEcommerce"
    name="YPsnDatiEcommerceForm"
    locktype="nolock"
    errorList="yes" menubar="yes" toolbar="yes" submitReset="none"
    webFormModifierClass="it.caleido.thip.base.connettori.utils.web.YPsnDatiEcommerceFormModifier"
    jsLibraryName="it/caleido/thip/base/connettori/utils/YPsnDatiEcommerce.js"
    onLoadPresent="yes"
    header="com.thera.thermfw.common.Header.jsp"
    footer="com.thera.thermfw.common.Footer.jsp">
    <menubar  name="myMenuBar">
      <import file="it/thera/thip/cs/defObjMenu.tfml"/>
    </menubar>
    <toolbar name="myToolBar" imgwidth="16" imgheight="16">
      <import file="it/thera/thip/cs/defObjMenu.tfml"/>
    </toolbar>
    <tabbed name="mytabbed" height="100%" width="100%">
      <tab name="tab1" resourceFile="it.caleido.thip.base.connettori.utils.resources.YPsnDatiEcommerce" resourceID="tab1">
        <multisearchform name="RelSerieOffVen" classRD="RelSerieOffVen" additionalfields="1"/>
        <multisearchform name="RelValuta" classRD="RelValuta"/>
        <multisearchform name="RelAssogIva" classRD="RelAssogIva"/>
        <multisearchform name="RelCauOffTes" classRD="RelCauOffTes"/>
        <multisearchform name="RelCauOffRig" classRD="RelCauOffRig"/>
        <multisearchform name="RelCauOffRigScMerce" classRD="RelCauOffRigScMerce"/>
        
        <editgrid name="SerieNumeratori" classCD="SerieNumeratori" type="include" visiblerows="8">
          <column classAD="RNazione"/>
          <column classAD="RNumeratore"/>
          <column classAD="RSerie"/>
          <rowform name="SerieNumeratoriRowForm" rowJSP="it.caleido.thip.base.connettori.utils.YPsnDatiEcommerceSerie.jsp"/>
        </editgrid>
        <editgrid name="Causali" classCD="Causali" type="include" visiblerows="8">
          <column classAD="RNazione"/>
          <column classAD="Preventivo"/>
          <column classAD="RCausale"/>
          <rowform name="CausaliRowForm" rowJSP="it.caleido.thip.base.connettori.utils.YPsnDatiEcommerceCausale.jsp"/>
        </editgrid>
      </tab>
    </tabbed>
  </form>
</tfml>

